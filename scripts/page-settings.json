{
  "_comment": "Yess Bangla — কোম্পানি প্রোফাইল PDF page settings. ভবিষ্যতে এখান থেকেই মার্জিন/ফুটার পরিবর্তন করুন।",
  "format": "A4",
  "orientation": "portrait",
  "margins": {
    "top": "38mm",
    "right": "18mm",
    "bottom": "32mm",
    "left": "18mm"
  },
  "header": {
    "enabled": true,
    "image": "public/letterhead-header.png",
    "heightMm": 35.6
  },
  "footer": {
    "enabled": true,
    "image": "public/letterhead-footer.png",
    "heightMm": 29.7,
    "pageNumber": {
      "enabled": true,
      "format": "পৃষ্ঠা {page} / {total}",
      "alignment": "right",
      "fontSizePt": 8,
      "color": "#0E2A3A",
      "marginBottomMm": 6,
      "marginRightMm": 14
    }
  },
  "skipHeaderFooterOnFirstPage": false
}
